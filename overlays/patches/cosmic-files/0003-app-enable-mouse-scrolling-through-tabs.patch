-// Utilities to build a temporary file hierarchy for tests.
+#[cfg(test)]
+mod wheel_tests {
+    use super::*;
+
+    #[test]
+    fn tab_wheel_scroll_selects_adjacent_tabs() {
+        assert!(matches!(
+            tab_switch_for_scroll(mouse::ScrollDelta::Lines { x: 0.0, y: -1.0 }),
+            Some(Message::TabNext)
+        ));
+        assert!(matches!(
+            tab_switch_for_scroll(mouse::ScrollDelta::Pixels { x: 0.0, y: 1.0 }),
+            Some(Message::TabPrev)
+        ));
+        assert!(matches!(
+            tab_switch_for_scroll(mouse::ScrollDelta::Pixels { x: 8.0, y: 1.0 }),
+            Some(Message::TabNext)
+        ));
+    }
+}
+
