Subject: [PATCH 3/3] app: enable mouse scrolling through tabs

---
 src/app.rs | 83 +++++++++++++++++++++++++++++++++++++++++++-----------
 1 file changed, 67 insertions(+), 16 deletions(-)

diff --git a/src/app.rs b/src/app.rs
index 5feb7f6..1b29fc9 100644
--- a/src/app.rs
+++ b/src/app.rs
@@ -488,6 +488,33 @@ pub enum Message {
     CutPaths(Vec<PathBuf>),
 }
 
+/// Maps a wheel gesture over the tab bar to the adjacent tab.
+///
+/// Vertical scrolling is preferred for a conventional mouse wheel. For a
+/// trackpad gesture, use the dominant axis so horizontal tab-bar scrolling is
+/// intuitive as well.
+fn tab_switch_for_scroll(delta: mouse::ScrollDelta) -> Option<Message> {
+    let (x, y) = match delta {
+        mouse::ScrollDelta::Lines { x, y } | mouse::ScrollDelta::Pixels { x, y } => (x, y),
+    };
+
+    if y.abs() >= x.abs() {
+        if y > 0.0 {
+            Some(Message::TabPrev)
+        } else if y < 0.0 {
+            Some(Message::TabNext)
+        } else {
+            None
+        }
+    } else if x > 0.0 {
+        Some(Message::TabNext)
+    } else if x < 0.0 {
+        Some(Message::TabPrev)
+    } else {
+        None
+    }
+}
+
