+                            .drag_id(self.tab_drag_id),
+                    )
+                    .on_scroll(tab_switch_for_scroll),
                 )
                 .width(Length::Fill)
                 .padding([0, space_s]),
@@ -7185,9 +7215,30 @@ impl Application for App {
     }
