+            // Rotating video thumbnails (grid view only): decode the still-missing
+            // VIDEO_SCRUB_FRACTIONS frames for the currently hovered video, and once at
+            // least one is ready, cycle through them on a timer.
+            #[cfg(feature = "video-thumbnails")]
+            if let Some(target_path) = &self.video_scrub_target
+                && let Some(item) = items
+                    .iter()
+                    .find(|item| item.path_opt().map(PathBuf::as_path) == Some(target_path))
+            {
+                for (idx, &fraction) in VIDEO_SCRUB_FRACTIONS.iter().enumerate() {
+                    if item.video_scrub_frames.borrow()[idx].is_some() {
+                        continue;
+                    }
+
+                    #[derive(Clone)]
+                    struct Wrapper {
+                        path: PathBuf,
+                        idx: usize,
+                        fraction: f64,
+                    }
+                    impl Hash for Wrapper {
+                        fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+                            self.path.hash(state);
+                            self.idx.hash(state);
+                        }
+                    }
+
+                    subscriptions.push(Subscription::run_with(
+                        Wrapper {
+                            path: target_path.clone(),
+                            idx,
+                            fraction,
+                        },
+                        |wrapper| {
+                            let Wrapper { path, idx, fraction } = wrapper.clone();
+                            stream::channel(
+                                1,
+                                move |mut output: futures::channel::mpsc::Sender<_>| async move {
+                                    let message = {
+                                        let path = path.clone();
+                                        let _permit = THUMB_SEMAPHORE.acquire().await.unwrap();
+                                        tokio::task::spawn_blocking(move || {
+                                            let handle_opt =
+                                                ItemThumbnail::video_frame_at(&path, fraction).map(
+                                                    |image| {
+                                                        let scaled = image
+                                                            .thumbnail(THUMBNAIL_SIZE, THUMBNAIL_SIZE)
+                                                            .into_rgba8();
+                                                        widget::icon::Handle {
+                                                            symbolic: false,
+                                                            data: widget::icon::Data::Image(
+                                                                widget::image::Handle::from_rgba(
+                                                                    scaled.width(),
+                                                                    scaled.height(),
+                                                                    scaled.into_raw(),
+                                                                ),
+                                                            ),
+                                                        }
+                                                    },
+                                                );
+                                            Message::VideoScrubFrame(path, idx, handle_opt)
+                                        })
+                                        .await
+                                        .unwrap()
+                                    };
+
+                                    match output.send(message).await {
+                                        Ok(()) => {}
+                                        Err(err) => {
+                                            log::warn!(
+                                                "failed to send video scrub frame {} for {}: {}",
+                                                idx,
+                                                path.display(),
+                                                err
+                                            );
+                                        }
+                                    }
+
+                                    std::future::pending().await
+                                },
+                            )
+                        },
+                    ));
+                }
+
+                if item.video_scrub_frames.borrow().iter().any(Option::is_some) {
+                    #[derive(Clone, Hash)]
+                    struct TickWrapper {
+                        path: PathBuf,
+                    }
+                    subscriptions.push(Subscription::run_with(
+                        TickWrapper {
+                            path: target_path.clone(),
+                        },
+                        |wrapper| {
+                            let _ = wrapper.clone();
+                            stream::channel(
+                                1,
+                                move |mut output: futures::channel::mpsc::Sender<_>| async move {
+                                    loop {
+                                        tokio::time::sleep(VIDEO_SCRUB_TICK).await;
+                                        if output.send(Message::VideoScrubTick).await.is_err() {
+                                            break;
+                                        }
+                                    }
+                                },
+                            )
+                        },
+                    ));
+                }
+            }
         }
 
