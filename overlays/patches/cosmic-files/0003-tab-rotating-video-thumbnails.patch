+    #[cfg(feature = "video-thumbnails")]
+    #[test]
+    fn item_thumbnail_video_scrub_frames_differ_across_video() -> io::Result<()> {
+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        let dir = TempDir::new()?;
+        let path = dir.path().join("test.mp4");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=10:size=64x48:rate=10",
+                "-c:v",
+                "libx264",
+                "-pix_fmt",
+                "yuv420p",
+                // A short keyframe interval so the 10%/90% marks land on distinct keyframes -
+                // extraction now just takes the frame nearest the seek target, so without this
+                // a default-GOP encode would only have one keyframe across a 10s/10fps clip.
+                "-g",
+                "10",
+                "-y",
+            ])
+            .arg(&path)
+            .status()?;
+        assert!(status.success(), "failed to generate test video");
+
+        // VIDEO_SCRUB_FRACTIONS samples the 10%/30%/50%/70%/90% marks; check the two
+        // extremes decode to valid, differently-timestamped frames of the same size.
+        let frame_10 = ItemThumbnail::video_frame_at(&path, 0.1).expect("expected frame at 10%");
+        let frame_90 = ItemThumbnail::video_frame_at(&path, 0.9).expect("expected frame at 90%");
+        assert_eq!((frame_10.width(), frame_10.height()), (64, 48));
+        assert_eq!((frame_90.width(), frame_90.height()), (64, 48));
+        assert_ne!(
+            frame_10.to_rgba8().into_raw(),
+            frame_90.to_rgba8().into_raw(),
+            "frames at 10% and 90% of a 10s video should not be pixel-identical"
+        );
+        Ok(())
+    }
+
+    #[cfg(feature = "video-thumbnails")]
+    #[test]
+    fn item_thumbnail_video_middle_frame_falls_back_on_slow_seek_format() -> io::Result<()> {
+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        let dir = TempDir::new()?;
+
+        // MP4/H.264 supports fast, index-based seeking - the static thumbnail should be a
+        // frame near the middle keyframe, distinct from the first frame.
+        let mp4_path = dir.path().join("test.mp4");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=10:size=64x48:rate=10",
+                "-c:v",
+                "libx264",
+                "-pix_fmt",
+                "yuv420p",
+                // A short keyframe interval so the 0%/50% marks land on distinct keyframes.
+                "-g",
+                "10",
+                "-y",
+            ])
+            .arg(&mp4_path)
+            .status()?;
+        assert!(status.success(), "failed to generate mp4 test video");
+        assert!(
+            ItemThumbnail::format_supports_fast_seek(&mp4_path),
+            "mp4 should report fast seek support"
+        );
+        let mp4_first = ItemThumbnail::video_frame_at(&mp4_path, 0.0)
+            .expect("expected first frame for mp4");
+        let mp4_middle =
+            ItemThumbnail::video_middle_frame(&mp4_path).expect("expected middle frame for mp4");
+        assert_ne!(
+            mp4_first.to_rgba8().into_raw(),
+            mp4_middle.to_rgba8().into_raw(),
+            "mp4 static thumbnail should be a frame near the middle, not the first frame"
+        );
+
+        // ASF/WMV disables ffmpeg's generic seek fallbacks (AVFMT_NOBINSEARCH |
+        // AVFMT_NOGENSEARCH), so the static thumbnail should fall back to the first frame.
+        let wmv_path = dir.path().join("test.wmv");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=10:size=64x48:rate=10",
+                "-c:v",
+                "msmpeg4v3",
+                "-y",
+            ])
+            .arg(&wmv_path)
+            .status()?;
+        assert!(status.success(), "failed to generate wmv test video");
+        assert!(
+            !ItemThumbnail::format_supports_fast_seek(&wmv_path),
+            "asf/wmv should report no fast seek support"
+        );
+        let wmv_first = ItemThumbnail::video_frame_at(&wmv_path, 0.0)
+            .expect("expected first frame for wmv");
+        let wmv_middle =
+            ItemThumbnail::video_middle_frame(&wmv_path).expect("expected fallback frame for wmv");
+        assert_eq!(
+            wmv_first.to_rgba8().into_raw(),
+            wmv_middle.to_rgba8().into_raw(),
+            "wmv static thumbnail should fall back to the first frame"
+        );
+
+        Ok(())
+    }
+
+    #[cfg(feature = "video-thumbnails")]
+    #[test]
+    fn item_thumbnail_video_sparse_keyframe_never_decodes_past_the_keyframe() -> io::Result<()> {
+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        // A single keyframe for the whole file (typical of some WebM/VP8/VP9 screen
+        // recordings) means every seek lands on frame 0. Since extraction now just takes the
+        // first frame the seek lands on rather than decoding forward towards the exact target,
+        // every fraction should resolve to that same frame - and cheaply, regardless of how
+        // far into a long file the target nominally is.
+        let dir = TempDir::new()?;
+        let path = dir.path().join("sparse_keyframe.webm");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=15:size=64x48:rate=30",
+                "-c:v",
+                "libvpx-vp9",
+                "-deadline",
+                "realtime",
+                "-cpu-used",
+                "8",
+                "-g",
+                "100000",
+                "-y",
+            ])
+            .arg(&path)
+            .status()?;
+        assert!(status.success(), "failed to generate test video");
+        assert_eq!(
+            std::process::Command::new("ffprobe")
+                .args([
+                    "-v", "error", "-select_streams", "v:0", "-show_entries",
+                    "frame=pict_type", "-of", "csv=p=0",
+                ])
+                .arg(&path)
+                .output()?
+                .stdout
+                .iter()
+                .filter(|&&b| b == b'I')
+                .count(),
+            1,
+            "test fixture should have exactly one keyframe"
+        );
+
+        let first = ItemThumbnail::video_frame_at(&path, 0.0).expect("expected first frame");
+        let middle = ItemThumbnail::video_frame_at(&path, 0.5).expect("expected frame at 50%");
+        let near_end = ItemThumbnail::video_frame_at(&path, 0.9).expect("expected frame at 90%");
+
+        // All three land on the sole keyframe, so they should be pixel-identical to the first
+        // frame - proving extraction never walks forward decoding intervening frames.
+        assert_eq!(
+            first.to_rgba8().into_raw(),
+            middle.to_rgba8().into_raw(),
+            "50% extraction on a single-keyframe file should match the first frame"
+        );
+        assert_eq!(
+            first.to_rgba8().into_raw(),
+            near_end.to_rgba8().into_raw(),
+            "90% extraction on a single-keyframe file should match the first frame"
+        );
+
+        Ok(())
+    }
 }
