From 9b6f6f3146e69824b096d38d24cde305cdf502fd Mon Sep 17 00:00:00 2001
From: Jonathan M <jgit@tuta.io>
Date: Thu, 20 Aug 2026 14:57:47 -0700
Subject: [PATCH 1/4] tab: enable thumbnails for remote drives

---
 src/tab.rs | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/tab.rs b/src/tab.rs
index 0da0db2..1d8cd2a 100644
--- a/src/tab.rs
+++ b/src/tab.rs
@@ -725,11 +725,10 @@ pub fn item_from_gvfs_info(path: PathBuf, file_info: gio::FileInfo, sizes: IconS
         icon_handle_grid,
         icon_handle_list,
         icon_handle_list_condensed,
-        thumbnail_opt: if remote {
-            Some(ItemThumbnail::NotImage)
-        } else {
-            None
-        },
+        // Thumbnail is computed asynchronously (even for remote/gvfs paths) by the
+        // subscription in `Tab::subscription`, which skips items whose thumbnail_opt
+        // is already set - so leave it unset here to allow previews on network drives.
+        thumbnail_opt: None,
         button_id: widget::Id::unique(),
         pos_opt: Cell::new(None),
         rect_opt: Cell::new(None),
@@ -861,7 +860,10 @@ pub fn item_from_entry(
         icon_handle_grid,
         icon_handle_list,
         icon_handle_list_condensed,
-        thumbnail_opt: remote.then_some(ItemThumbnail::NotImage),
+        // Thumbnail is computed asynchronously (even for remote paths) by the
+        // subscription in `Tab::subscription`, which skips items whose thumbnail_opt
+        // is already set - so leave it unset here to allow previews on network drives.
+        thumbnail_opt: None,
         button_id: widget::Id::unique(),
         pos_opt: Cell::new(None),
         rect_opt: Cell::new(None),
-- 
