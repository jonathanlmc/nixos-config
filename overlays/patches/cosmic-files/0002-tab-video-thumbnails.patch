+        // Try built-in video thumbnailer: extracts the middle frame directly via libav
+        // (no size limit - a single decoded frame is cheap regardless of file length).
+        // This runs before the generic external thumbnailers below since freedesktop
+        // registered video thumbnailers (e.g. totem-video-thumbnailer) don't reliably
+        // grab the middle frame.
+        #[cfg(feature = "video-thumbnails")]
+        if mime.type_() == mime::VIDEO {
+            // Only mark this as "tried" once extraction is actually attempted, so a
+            // build without the feature falls through to external thumbnailers instead
+            // of permanently caching a failure for every video it sees.
+            tried_supported_file = true;
+            if let Some(frame) = Self::video_middle_frame(path) {
+                let (frame_width, frame_height) = (frame.width(), frame.height());
+                if let Ok(cacher) = thumbnail_cacher.as_ref() {
+                    match cacher.update_with_image(frame) {
+                        Ok(thumb_path) => {
+                            return Self::Image(
+                                widget::image::Handle::from_path(thumb_path),
+                                Some((frame_width, frame_height)),
+                            );
+                        }
+                        Err(err) => {
+                            log::warn!(
+                                "cacher failed to cache video thumbnail for {}: {}",
+                                path.display(),
+                                err
+                            );
+                        }
+                    }
+                } else {
+                    // Fallback for when thumbnail cacher isn't available.
+                    let thumbnail = frame
+                        .thumbnail(thumbnail_size, thumbnail_size)
+                        .into_rgba8();
+                    return Self::Image(
+                        widget::image::Handle::from_rgba(
+                            thumbnail.width(),
+                            thumbnail.height(),
+                            thumbnail.into_raw(),
+                        ),
+                        Some((frame_width, frame_height)),
+                    );
+                }
+            }
+        }
+
         // Try external thumbnailers.
         let thumbnail_dir = thumbnail_cacher
             .as_ref()
@@ -2294,6 +2340,117 @@ impl ItemThumbnail {
 
         None
     }
+
+    /// Extracts the frame at the midpoint of the video's duration by decoding directly
+    /// with libav (via `ffmpeg-next`), rather than shelling out to the `ffmpeg` binary.
+    /// Returns `None` on any failure (unsupported format, no video stream, decode error).
+    #[cfg(feature = "video-thumbnails")]
+    fn video_middle_frame(path: &Path) -> Option<DynamicImage> {
+        use ffmpeg_next as ffmpeg;
+
+        // Safe to call repeatedly; only sets up libav's internal state once.
+        if let Err(err) = ffmpeg::init() {
+            log::warn!("failed to initialize ffmpeg: {err}");
+            return None;
+        }
+
+        let mut input = match ffmpeg::format::input(path) {
+            Ok(input) => input,
+            Err(err) => {
+                log::debug!("ffmpeg failed to open {}: {}", path.display(), err);
+                return None;
+            }
+        };
+
+        let video_stream = input.streams().best(ffmpeg::media::Type::Video)?;
+        let video_stream_index = video_stream.index();
+        let mut decoder =
+            match ffmpeg::codec::context::Context::from_parameters(video_stream.parameters())
+                .and_then(|context| context.decoder().video())
+            {
+                Ok(decoder) => decoder,
+                Err(err) => {
+                    log::debug!(
+                        "failed to open video decoder for {}: {}",
+                        path.display(),
+                        err
+                    );
+                    return None;
+                }
+            };
+
+        // Seek to the midpoint of the container's duration (AV_TIME_BASE units).
+        // This is a best-effort, keyframe-based seek, same as `ffmpeg -ss`; if the
+        // duration is unknown, fall back to decoding from the start of the file.
+        let duration = input.duration();
+        if duration > 0 {
+            let target = duration / 2;
+            if let Err(err) = input.seek(target, ..) {
+                log::debug!("failed to seek {} to midpoint: {}", path.display(), err);
+            }
+        }
+
+        let mut scaler: Option<ffmpeg::software::scaling::Context> = None;
+        let mut decoded = ffmpeg::frame::Video::empty();
+        for (stream, packet) in input.packets() {
+            if stream.index() != video_stream_index || decoder.send_packet(&packet).is_err() {
+                continue;
+            }
+
+            while decoder.receive_frame(&mut decoded).is_ok() {
+                let (width, height) = (decoded.width(), decoded.height());
+                if width == 0 || height == 0 {
+                    continue;
+                }
+
+                let ctx = match &mut scaler {
+                    Some(ctx) => ctx,
+                    None => {
+                        let ctx = ffmpeg::software::scaling::Context::get(
+                            decoded.format(),
+                            width,
+                            height,
+                            ffmpeg::format::Pixel::RGBA,
+                            width,
+                            height,
+                            ffmpeg::software::scaling::Flags::BILINEAR,
+                        )
+                        .inspect_err(|err| {
+                            log::warn!(
+                                "failed to create scaler for {}: {}",
+                                path.display(),
+                                err
+                            );
+                        })
+                        .ok()?;
+                        scaler.insert(ctx)
+                    }
+                };
+
+                let mut rgba = ffmpeg::frame::Video::empty();
+                if let Err(err) = ctx.run(&decoded, &mut rgba) {
+                    log::warn!("failed to scale frame from {}: {}", path.display(), err);
+                    return None;
+                }
+
+                // The scaled frame's rows may be padded to a stride wider than the
+                // pixel data, so copy row-by-row into a tightly packed buffer.
+                let stride = rgba.stride(0);
+                let data = rgba.data(0);
+                let row_bytes = width as usize * 4;
+                let mut buf = Vec::with_capacity(row_bytes * height as usize);
+                for row in 0..height as usize {
+                    let start = row * stride;
+                    buf.extend_from_slice(&data[start..start + row_bytes]);
+                }
+
+                return image::RgbaImage::from_raw(width, height, buf)
+                    .map(DynamicImage::ImageRgba8);
+            }
+        }
+
+        None
+    }
 }
 
 #[derive(Clone, Debug)]
@@ -7936,4 +8093,61 @@ mod tests {
         }
         Ok(())
     }
+
+    #[cfg(feature = "video-thumbnails")]
+    #[test]
+    fn item_thumbnail_video_uses_ffmpeg_middle_frame() -> io::Result<()> {
+        // The `ffmpeg` binary is only used here to generate a test fixture; the
+        // production code path decodes directly via the `ffmpeg-next` bindings.
+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        let dir = TempDir::new()?;
+        let path = dir.path().join("test.mp4");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=2:size=64x48:rate=10",
+                "-c:v",
+                "libx264",
+                "-pix_fmt",
+                "yuv420p",
+                "-y",
+            ])
+            .arg(&path)
+            .status()?;
+        assert!(status.success(), "failed to generate test video");
+
+        let metadata = fs::metadata(&path)?;
+        let item_metadata = ItemMetadata::Path {
+            metadata,
+            children_opt: None,
+        };
+        let thumb = ItemThumbnail::new(
+            &path,
+            item_metadata,
+            "video/mp4".parse().unwrap(),
+            128,
+            100 * 1024 * 1024,
+            1,
+            100,
+        );
+        match &thumb {
+            ItemThumbnail::Image(_, dims) => {
+                assert_eq!(*dims, Some((64, 48)), "unexpected extracted frame size");
+            }
+            _ => panic!("expected Image thumbnail from ffmpeg, got {:?}", thumb),
+        }
+        Ok(())
+    }
 }
