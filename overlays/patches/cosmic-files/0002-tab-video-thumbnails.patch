diff --git a/src/tab.rs b/src/tab.rs
index 1d8cd2a..351c6c5 100644
--- a/src/tab.rs
+++ b/src/tab.rs
@@ -2120,6 +2120,52 @@ impl ItemThumbnail {
             }
         }
 
+        // Try built-in video thumbnailer: extracts the middle frame directly via libav
+        // (no size limit - a single decoded frame is cheap regardless of file length).
+        // This runs before the generic external thumbnailers below since freedesktop
+        // registered video thumbnailers (e.g. totem-video-thumbnailer) don't reliably
+        // grab the middle frame.
+        #[cfg(feature = "video-thumbnails")]
+        if mime.type_() == mime::VIDEO {
+            // Only mark this as "tried" once extraction is actually attempted, so a
+            // build without the feature falls through to external thumbnailers instead
+            // of permanently caching a failure for every video it sees.
+            tried_supported_file = true;
+            if let Some(frame) = Self::video_middle_frame(path) {
+                let (frame_width, frame_height) = (frame.width(), frame.height());
+                if let Ok(cacher) = thumbnail_cacher.as_ref() {
+                    match cacher.update_with_image(frame) {
+                        Ok(thumb_path) => {
+                            return Self::Image(
+                                widget::image::Handle::from_path(thumb_path),
+                                Some((frame_width, frame_height)),
+                            );
+                        }
+                        Err(err) => {
+                            log::warn!(
+                                "cacher failed to cache video thumbnail for {}: {}",
+                                path.display(),
+                                err
+                            );
+                        }
+                    }
+                } else {
+                    // Fallback for when thumbnail cacher isn't available.
+                    let thumbnail = frame
+                        .thumbnail(thumbnail_size, thumbnail_size)
+                        .into_rgba8();
+                    return Self::Image(
+                        widget::image::Handle::from_rgba(
+                            thumbnail.width(),
+                            thumbnail.height(),
+                            thumbnail.into_raw(),
+                        ),
+                        Some((frame_width, frame_height)),
+                    );
+                }
+            }
+        }
+
         // Try external thumbnailers.
         let thumbnail_dir = thumbnail_cacher
             .as_ref()
@@ -2294,6 +2340,165 @@ impl ItemThumbnail {
 
         None
     }
+
+    /// Extracts a frame near the midpoint of the video's duration (see [`Self::video_frame_at`]
+    /// for how close), or the first frame if the container doesn't support fast seeking (see
+    /// [`Self::format_supports_fast_seek`]) - for those formats a seek to an arbitrary
+    /// timestamp is either unsupported or only a rough, best-effort guess, so seeking towards
+    /// the midpoint isn't reliable at all.
+    #[cfg(feature = "video-thumbnails")]
+    fn video_middle_frame(path: &Path) -> Option<DynamicImage> {
+        let fraction = if Self::format_supports_fast_seek(path) {
+            0.5
+        } else {
+            0.0
+        };
+        Self::video_frame_at(path, fraction)
+    }
+
+    /// Whether `path`'s container format supports fast, index-based seeking to an arbitrary
+    /// timestamp. Determined from the `AVFMT_NOBINSEARCH`/`AVFMT_NOGENSEARCH` flags on the
+    /// probed input format: when both are set (e.g. ASF/WMV), ffmpeg's generic seek fallbacks
+    /// are disabled, meaning the demuxer either has no seek support or only a coarse,
+    /// non-frame-accurate one of its own - the common containers (MP4, Matroska/WebM, AVI,
+    /// MPEG-TS, etc.) all leave these flags unset.
+    #[cfg(feature = "video-thumbnails")]
+    fn format_supports_fast_seek(path: &Path) -> bool {
+        use ffmpeg_next as ffmpeg;
+
+        let Ok(input) = ffmpeg::format::input(path) else {
+            return false;
+        };
+
+        let flags = ffmpeg::format::flag::Flags::from_bits_truncate(unsafe {
+            (*input.format().as_ptr()).flags
+        });
+        !flags.contains(
+            ffmpeg::format::flag::Flags::NO_BINSEARCH | ffmpeg::format::flag::Flags::NO_GENSEARCH,
+        )
+    }
+
+    /// Extracts the frame nearest `fraction` (0.0 = start, 1.0 = end) of the video's duration,
+    /// by decoding directly with libav (via `ffmpeg-next`) rather than shelling out to the
+    /// `ffmpeg` binary. Only ever decodes a single frame - the one the seek lands on/near, i.e.
+    /// the nearest keyframe at or before the target - rather than decoding forward to the exact
+    /// timestamp, so the result can be up to one keyframe-interval short of the true target.
+    /// Returns `None` on any failure (unsupported format, no video stream, decode error, or a
+    /// seek target past the last decodable frame).
+    #[cfg(feature = "video-thumbnails")]
+    fn video_frame_at(path: &Path, fraction: f64) -> Option<DynamicImage> {
+        use ffmpeg_next as ffmpeg;
+
+        // Safe to call repeatedly; only sets up libav's internal state once.
+        if let Err(err) = ffmpeg::init() {
+            log::warn!("failed to initialize ffmpeg: {err}");
+            return None;
+        }
+
+        let mut input = match ffmpeg::format::input(path) {
+            Ok(input) => input,
+            Err(err) => {
+                log::debug!("ffmpeg failed to open {}: {}", path.display(), err);
+                return None;
+            }
+        };
+
+        let video_stream = input.streams().best(ffmpeg::media::Type::Video)?;
+        let video_stream_index = video_stream.index();
+        let mut decoder =
+            match ffmpeg::codec::context::Context::from_parameters(video_stream.parameters())
+                .and_then(|context| context.decoder().video())
+            {
+                Ok(decoder) => decoder,
+                Err(err) => {
+                    log::debug!(
+                        "failed to open video decoder for {}: {}",
+                        path.display(),
+                        err
+                    );
+                    return None;
+                }
+            };
+
+        // Seek to `fraction` of the container's duration (AV_TIME_BASE units). This only
+        // guarantees landing at or before the nearest preceding keyframe - it never lands
+        // exactly on an arbitrary target, since every frame between keyframes is coded as a
+        // delta against other frames and so can't be produced without decoding the whole
+        // reference chain back to a keyframe. If the duration is unknown, fall back to
+        // decoding from the start of the file.
+        let duration = input.duration();
+        let target_secs = fraction.clamp(0.0, 1.0) * (duration.max(0) as f64 / 1_000_000.0);
+        if duration > 0 {
+            let seek_target = (target_secs * 1_000_000.0) as i64;
+            if let Err(err) = input.seek(seek_target, ..) {
+                log::debug!(
+                    "failed to seek {} to {:.0}%: {}",
+                    path.display(),
+                    fraction * 100.0,
+                    err
+                );
+            }
+        }
+
+        // Rather than paying to decode forward to the exact target timestamp (arbitrarily
+        // expensive for a container with sparse keyframes), just take the first frame the
+        // seek lands on/near. That's always the nearest preceding keyframe, which is a good
+        // enough approximation of `fraction` for a thumbnail, and bounds every extraction to
+        // exactly one frame decode regardless of the container's keyframe interval.
+        let mut decoded = ffmpeg::frame::Video::empty();
+        let mut found = false;
+        'search: for (stream, packet) in input.packets() {
+            if stream.index() != video_stream_index || decoder.send_packet(&packet).is_err() {
+                continue;
+            }
+
+            while decoder.receive_frame(&mut decoded).is_ok() {
+                if decoded.width() == 0 || decoded.height() == 0 {
+                    continue;
+                }
+                found = true;
+                break 'search;
+            }
+        }
+
+        if !found {
+            return None;
+        }
+
+        let (width, height) = (decoded.width(), decoded.height());
+        let mut scaler = ffmpeg::software::scaling::Context::get(
+            decoded.format(),
+            width,
+            height,
+            ffmpeg::format::Pixel::RGBA,
+            width,
+            height,
+            ffmpeg::software::scaling::Flags::BILINEAR,
+        )
+        .inspect_err(|err| {
+            log::warn!("failed to create scaler for {}: {}", path.display(), err);
+        })
+        .ok()?;
+
+        let mut rgba = ffmpeg::frame::Video::empty();
+        if let Err(err) = scaler.run(&decoded, &mut rgba) {
+            log::warn!("failed to scale frame from {}: {}", path.display(), err);
+            return None;
+        }
+
+        // The scaled frame's rows may be padded to a stride wider than the pixel data, so
+        // copy row-by-row into a tightly packed buffer.
+        let stride = rgba.stride(0);
+        let data = rgba.data(0);
+        let row_bytes = width as usize * 4;
+        let mut buf = Vec::with_capacity(row_bytes * height as usize);
+        for row in 0..height as usize {
+            let start = row * stride;
+            buf.extend_from_slice(&data[start..start + row_bytes]);
+        }
+
+        image::RgbaImage::from_raw(width, height, buf).map(DynamicImage::ImageRgba8)
+    }
 }
 
 #[derive(Clone, Debug)]
@@ -7936,4 +8141,61 @@ mod tests {
         }
         Ok(())
     }
+
+    #[cfg(feature = "video-thumbnails")]
+    #[test]
+    fn item_thumbnail_video_uses_ffmpeg_middle_frame() -> io::Result<()> {
+        // The `ffmpeg` binary is only used here to generate a test fixture; the
+        // production code path decodes directly via the `ffmpeg-next` bindings.
+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        let dir = TempDir::new()?;
+        let path = dir.path().join("test.mp4");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=2:size=64x48:rate=10",
+                "-c:v",
+                "libx264",
+                "-pix_fmt",
+                "yuv420p",
+                "-y",
+            ])
+            .arg(&path)
+            .status()?;
+        assert!(status.success(), "failed to generate test video");
+
+        let metadata = fs::metadata(&path)?;
+        let item_metadata = ItemMetadata::Path {
+            metadata,
+            children_opt: None,
+        };
+        let thumb = ItemThumbnail::new(
+            &path,
+            item_metadata,
+            "video/mp4".parse().unwrap(),
+            128,
+            100 * 1024 * 1024,
+            1,
+            100,
+        );
+        match &thumb {
+            ItemThumbnail::Image(_, dims) => {
+                assert_eq!(*dims, Some((64, 48)), "unexpected extracted frame size");
+            }
+            _ => panic!("expected Image thumbnail from ffmpeg, got {:?}", thumb),
+        }
+        Ok(())
+    }
 }
