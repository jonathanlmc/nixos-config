+    #[cfg(feature = "video-thumbnails")]
+    #[test]
+    fn item_thumbnail_video_sparse_keyframe_never_decodes_past_the_keyframe() -> io::Result<()> {
+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        // a single keyframe for the whole file (typical of some WebM/VP8/VP9 screen
+        // recordings) means every seek lands on frame 0
+        //
+        // since extraction now just takes the first frame the seek lands on rather than
+        // decoding forward towards the exact target, every fraction should resolve to that
+        // same frame - and cheaply, regardless of how far into a long file the target
+        // nominally is
+        let dir = TempDir::new()?;
+        let path = dir.path().join("sparse_keyframe.webm");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=15:size=64x48:rate=30",
+                "-c:v",
+                "libvpx-vp9",
+                "-deadline",
+                "realtime",
+                "-cpu-used",
+                "8",
+                "-g",
+                "100000",
+                "-y",
+            ])
+            .arg(&path)
+            .status()?;
+        assert!(status.success(), "failed to generate test video");
+        assert_eq!(
+            std::process::Command::new("ffprobe")
+                .args([
+                    "-v", "error", "-select_streams", "v:0", "-show_entries",
+                    "frame=pict_type", "-of", "csv=p=0",
+                ])
+                .arg(&path)
+                .output()?
+                .stdout
+                .iter()
+                .filter(|&&b| b == b'I')
+                .count(),
+            1,
+            "test fixture should have exactly one keyframe"
+        );
+
+        let first = ItemThumbnail::video_frame_at(&path, 0.0).expect("expected first frame");
+        let middle = ItemThumbnail::video_frame_at(&path, 0.5).expect("expected frame at 50%");
+        let near_end = ItemThumbnail::video_frame_at(&path, 0.9).expect("expected frame at 90%");
+
+        // all three land on the sole keyframe, so they should be pixel-identical to the first
+        // frame - proving extraction never walks forward decoding intervening frames
+        assert_eq!(
+            first.to_rgba8().into_raw(),
+            middle.to_rgba8().into_raw(),
+            "50% extraction on a single-keyframe file should match the first frame"
+        );
+        assert_eq!(
+            first.to_rgba8().into_raw(),
+            near_end.to_rgba8().into_raw(),
+            "90% extraction on a single-keyframe file should match the first frame"
+        );
+
+        Ok(())
+    }
