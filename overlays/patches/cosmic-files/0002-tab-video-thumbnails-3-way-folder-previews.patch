+            }
+        }
+
+        let items = tab.items_opt.as_ref().unwrap();
+        let target_dir = items[0]
+            .path_opt()
+            .cloned()
+            .expect("dir item should have a path");
+        let other_dir = items[1]
+            .path_opt()
+            .cloned()
+            .expect("dir item should have a path");
+        // `simple_fs` populates every directory with plain files named "0", "1", ...
+        let grandchild = target_dir.join("0");
+
+        assert!(
+            tab.invalidate_folder_sample_for_child(&grandchild),
+            "a direct child of a tracked folder item should be recognized"
+        );
+
+        let items = tab.items_opt.as_ref().unwrap();
+        let target_item = items
+            .iter()
+            .find(|i| i.path_opt() == Some(&target_dir))
+            .unwrap();
+        let other_item = items
+            .iter()
+            .find(|i| i.path_opt() == Some(&other_dir))
+            .unwrap();
+        assert!(
+            target_item.thumbnail_opt.is_none(),
+            "the folder whose child changed should be invalidated"
+        );
+        assert!(
+            other_item.thumbnail_opt.is_some(),
+            "unrelated folders should be left alone"
+        );
