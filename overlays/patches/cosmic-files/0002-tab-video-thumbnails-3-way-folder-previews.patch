+    /// Direct, non-hidden children of a folder: regular files as folder-sample candidates,
+    /// unsorted, plus the subdirectories, which callers use to keep searching when this level
+    /// has no visual candidate. Honors the same hiding rules as the main item listing - a
+    /// leading dot, the OS hidden attribute, or a name listed in the folder's `.hidden` file -
+    /// so a folder sample never surfaces a file the user has hidden. Returns `None` if the
+    /// directory can't be read.
+    fn folder_sample_direct_children_unsorted(
+        path: &Path,
+    ) -> Option<(Vec<FolderSampleCandidate>, Vec<PathBuf>)> {
+        let entries = match fs::read_dir(path) {
+            Ok(entries) => entries,
+            Err(err) => {
+                log::debug!("failed to read folder sample for {}: {err}", path.display());
+                return None;
+            }
+        };
+        let hidden_names = parse_hidden_file(&path.join(".hidden"));
+        let mut candidates = Vec::new();
+        let mut subdirs = Vec::new();
+        for entry in entries.filter_map(Result::ok) {
+            let name = entry.file_name();
+            if name.as_encoded_bytes().first() == Some(&b'.') {
+                continue;
+            }
+            if hidden_names
+                .iter()
+                .any(|hidden| std::ffi::OsStr::new(hidden) == name)
+            {
+                continue;
+            }
+            let child_path = entry.path();
+            let Ok(metadata) = entry.metadata() else {
+                continue;
+            };
+            if hidden_attribute(&metadata) {
+                continue;
+            }
+            if metadata.is_dir() {
