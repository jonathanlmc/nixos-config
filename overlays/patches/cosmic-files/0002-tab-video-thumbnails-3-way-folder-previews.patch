+        if std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_err()
+        {
+            eprintln!("skipping test: ffmpeg binary not installed");
+            return Ok(());
+        }
+
+        let dir = TempDir::new()?;
+        let path = dir.path().join("test.mp4");
+        let status = std::process::Command::new("ffmpeg")
+            .args([
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "testsrc=duration=10:size=64x48:rate=10",
+                "-c:v",
+                "libx264",
+                "-pix_fmt",
+                "yuv420p",
+                // a short keyframe interval so the 10%/90% marks land on distinct keyframes -
+                // extraction now just takes the frame nearest the seek target, so without this
+                // a default-GOP encode would only have one keyframe across a 10s/10fps clip
+                "-g",
+                "10",
+                "-y",
+            ])
+            .arg(&path)
+            .status()?;
+        assert!(status.success(), "failed to generate test video");
+
+        // VIDEO_SCRUB_FRACTIONS samples the 10%/30%/50%/70%/90% marks; check the two
+        // extremes decode to valid, differently-timestamped frames of the same size
+        let frame_10 = ItemThumbnail::video_frame_at(&path, 0.1).expect("expected frame at 10%");
+        let frame_90 = ItemThumbnail::video_frame_at(&path, 0.9).expect("expected frame at 90%");
+        assert_eq!((frame_10.width(), frame_10.height()), (64, 48));
+        assert_eq!((frame_90.width(), frame_90.height()), (64, 48));
+        assert_ne!(
+            frame_10.to_rgba8().into_raw(),
+            frame_90.to_rgba8().into_raw(),
+            "frames at 10% and 90% of a 10s video should not be pixel-identical"
+        );
+        Ok(())
+    }
